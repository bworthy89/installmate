<Page
    x:Class="InstallVibe.Examples.VirtualizedListExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <!--
        VirtualizedListExample.xaml - Demonstration of efficient list virtualization

        Virtualization ensures only visible items are rendered, improving performance
        for long lists (100+ items). Use ItemsRepeater for best performance.
    -->

    <Page.Resources>
        <!-- Step Card Data Template -->
        <DataTemplate x:Key="StepCardTemplate">
            <Border
                Style="{StaticResource ElevatedCardStyle}"
                Margin="{StaticResource VerticalSpacingSmall}"
                Padding="{StaticResource CardPadding}"
                PointerEntered="Card_PointerEntered"
                PointerExited="Card_PointerExited"
                AutomationProperties.Name="{Binding Title, StringFormat='Step: {0}'}">

                <!-- Add transforms for animations -->
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail with lazy loading -->
                    <Grid
                        Grid.Column="0"
                        Width="80"
                        Height="80"
                        Margin="0,0,16,0"
                        CornerRadius="{StaticResource CornerRadiusSmall}"
                        Background="{ThemeResource SurfaceBrush}">

                        <!-- Placeholder while loading -->
                        <FontIcon
                            Glyph="&#xE8B9;"
                            FontSize="32"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Visibility="{Binding IsImageLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <!-- Actual thumbnail (lazy loaded) -->
                        <Image
                            Source="{Binding ThumbnailPath}"
                            Stretch="UniformToFill"
                            Visibility="{Binding IsImageLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                            ImageOpened="Thumbnail_ImageOpened"
                            AutomationProperties.Name="{Binding Title, StringFormat='Thumbnail for {0}'}" />
                    </Grid>

                    <!-- Content -->
                    <StackPanel Grid.Column="1" Spacing="4">
                        <!-- Step Number and Title -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="{Binding StepNumber, StringFormat='Step {0}'}"
                                Style="{StaticResource CaptionTextStyle}"
                                Foreground="{StaticResource BrandPrimaryBrush}" />
                            <TextBlock
                                Text="{Binding Title}"
                                Style="{StaticResource TitleMediumTextStyle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Short Instruction -->
                        <TextBlock
                            Text="{Binding ShortInstruction}"
                            Style="{StaticResource BodySecondaryTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="2" />

                        <!-- Metadata -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <!-- Estimated Time -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE917;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock
                                    Text="{Binding EstimatedMinutes, StringFormat='{0} min'}"
                                    Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>

                            <!-- Tools Required -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding HasTools, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE90F;" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock
                                    Text="Tools required"
                                    Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Completion Status -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <!-- Checkmark for completed steps -->
                        <Border
                            Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="{StaticResource BrandSuccessBrush}"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"
                            RenderTransformOrigin="0.5,0.5"
                            AutomationProperties.Name="Completed">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <FontIcon
                                Glyph="&#xE73E;"
                                Foreground="White"
                                FontSize="20" />
                        </Border>

                        <!-- Pending/In Progress indicator -->
                        <Border
                            Width="40"
                            Height="40"
                            CornerRadius="20"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="2"
                            Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            AutomationProperties.Name="Pending">
                            <FontIcon
                                Glyph="&#xE7C3;"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                FontSize="16" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Lazy Loading Item Template (minimal initial render) -->
        <DataTemplate x:Key="LazyStepCardTemplate">
            <!-- This template renders a simple placeholder initially -->
            <Border
                Height="100"
                Margin="{StaticResource VerticalSpacingSmall}"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="{StaticResource CornerRadiusMedium}">
                <ProgressRing IsActive="True" Width="24" Height="24" />
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PaddingLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Installation Steps" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock
                Text="Virtualized list with lazy-loaded thumbnails for optimal performance"
                Style="{StaticResource BodySecondaryTextStyle}" />
        </StackPanel>

        <!-- Virtualized List using ItemsRepeater (Recommended) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                x:Name="StepsRepeater"
                ItemTemplate="{StaticResource StepCardTemplate}"
                ElementPrepared="ItemsRepeater_ElementPrepared"
                ElementClearing="ItemsRepeater_ElementClearing"
                AutomationProperties.Name="Installation Steps List">

                <!-- Virtualization Layout (UniformGridLayout or StackLayout) -->
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>

                <!-- Animator for smooth item additions/removals -->
                <ItemsRepeater.ItemTransitionProvider>
                    <DefaultElementAnimator />
                </ItemsRepeater.ItemTransitionProvider>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Alternative: ListView with VirtualizingStackPanel (Legacy approach) -->
        <!--
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Steps, Mode=OneWay}"
                  ItemTemplate="{StaticResource StepCardTemplate}"
                  ItemContainerStyle="{StaticResource AccessibleListViewItemStyle}"
                  SelectionMode="None">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
        -->
    </Grid>
</Page>
