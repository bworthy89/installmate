<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme.xaml - Semantic color tokens that adapt to Light/Dark themes
        These resources use ThemeResource for automatic theme switching
    -->

    <ResourceDictionary.ThemeDictionaries>
        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <!-- Background Colors -->
            <Color x:Key="AppBackgroundColor">#FFFFFF</Color>
            <Color x:Key="SurfaceColor">#F5F5F5</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="OverlayColor">#F9F9F9</Color>

            <!-- Text Colors -->
            <Color x:Key="TextPrimaryColor">#212121</Color>
            <Color x:Key="TextSecondaryColor">#757575</Color>
            <Color x:Key="TextDisabledColor">#BDBDBD</Color>
            <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

            <!-- Border & Divider Colors -->
            <Color x:Key="BorderColor">#E0E0E0</Color>
            <Color x:Key="DividerColor">#EEEEEE</Color>
            <Color x:Key="FocusStrokeColor">#0078D4</Color>

            <!-- Interactive States -->
            <Color x:Key="HoverOverlayColor">#0D000000</Color> <!-- 5% black -->
            <Color x:Key="PressedOverlayColor">#1A000000</Color> <!-- 10% black -->
            <Color x:Key="SelectedBackgroundColor">#E3F2FD</Color>

            <!-- Status Colors (Light theme variants) -->
            <Color x:Key="SuccessBackgroundColor">#E8F5E9</Color>
            <Color x:Key="WarningBackgroundColor">#FFF3E0</Color>
            <Color x:Key="ErrorBackgroundColor">#FFEBEE</Color>
            <Color x:Key="InfoBackgroundColor">#E3F2FD</Color>
        </ResourceDictionary>

        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">
            <!-- Background Colors -->
            <Color x:Key="AppBackgroundColor">#1E1E1E</Color>
            <Color x:Key="SurfaceColor">#252525</Color>
            <Color x:Key="CardBackgroundColor">#2D2D2D</Color>
            <Color x:Key="OverlayColor">#333333</Color>

            <!-- Text Colors -->
            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#B0B0B0</Color>
            <Color x:Key="TextDisabledColor">#6E6E6E</Color>
            <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

            <!-- Border & Divider Colors -->
            <Color x:Key="BorderColor">#3D3D3D</Color>
            <Color x:Key="DividerColor">#2D2D2D</Color>
            <Color x:Key="FocusStrokeColor">#4A9EE0</Color>

            <!-- Interactive States -->
            <Color x:Key="HoverOverlayColor">#0DFFFFFF</Color> <!-- 5% white -->
            <Color x:Key="PressedOverlayColor">#1AFFFFFF</Color> <!-- 10% white -->
            <Color x:Key="SelectedBackgroundColor">#1E3A52</Color>

            <!-- Status Colors (Dark theme variants) -->
            <Color x:Key="SuccessBackgroundColor">#1B3A26</Color>
            <Color x:Key="WarningBackgroundColor">#3D3020</Color>
            <Color x:Key="ErrorBackgroundColor">#3D2222</Color>
            <Color x:Key="InfoBackgroundColor">#1E3A52</Color>
        </ResourceDictionary>

        <!-- High Contrast Theme -->
        <ResourceDictionary x:Key="HighContrast">
            <!-- Use system high contrast colors -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FocusStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Semantic Brushes (use ThemeResource for automatic theme switching) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{ThemeResource OverlayColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{ThemeResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{ThemeResource TextOnPrimaryColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource DividerColor}" />
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="{ThemeResource FocusStrokeColor}" />

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{ThemeResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="{ThemeResource PressedOverlayColor}" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{ThemeResource SelectedBackgroundColor}" />

    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{ThemeResource SuccessBackgroundColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{ThemeResource WarningBackgroundColor}" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{ThemeResource ErrorBackgroundColor}" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{ThemeResource InfoBackgroundColor}" />

    <!-- Merge base colors -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
