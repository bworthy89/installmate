<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors -->
    <Color x:Key="BrandPrimaryColor">#0078D4</Color>
    <Color x:Key="BrandPrimaryDarkColor">#005A9E</Color>
    <Color x:Key="BrandPrimaryLightColor">#4A9EE0</Color>
    <Color x:Key="BrandAccentColor">#FF6B35</Color>
    <Color x:Key="BrandSuccessColor">#0F9D58</Color>
    <Color x:Key="BrandWarningColor">#F9AB00</Color>
    <Color x:Key="BrandErrorColor">#D32F2F</Color>

    <!-- Neutral Colors -->
    <Color x:Key="NeutralGray50">#FAFAFA</Color>
    <Color x:Key="NeutralGray100">#F5F5F5</Color>
    <Color x:Key="NeutralGray200">#EEEEEE</Color>
    <Color x:Key="NeutralGray300">#E0E0E0</Color>
    <Color x:Key="NeutralGray400">#BDBDBD</Color>
    <Color x:Key="NeutralGray500">#9E9E9E</Color>
    <Color x:Key="NeutralGray600">#757575</Color>
    <Color x:Key="NeutralGray700">#616161</Color>
    <Color x:Key="NeutralGray800">#424242</Color>
    <Color x:Key="NeutralGray900">#212121</Color>

    <!-- Brand Color Brushes -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}" />
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{StaticResource BrandPrimaryLightColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandSuccessBrush" Color="{StaticResource BrandSuccessColor}" />
    <SolidColorBrush x:Key="BrandWarningBrush" Color="{StaticResource BrandWarningColor}" />
    <SolidColorBrush x:Key="BrandErrorBrush" Color="{StaticResource BrandErrorColor}" />

    <!-- Neutral Brushes -->
    <SolidColorBrush x:Key="NeutralGray50Brush" Color="{StaticResource NeutralGray50}" />
    <SolidColorBrush x:Key="NeutralGray100Brush" Color="{StaticResource NeutralGray100}" />
    <SolidColorBrush x:Key="NeutralGray200Brush" Color="{StaticResource NeutralGray200}" />
    <SolidColorBrush x:Key="NeutralGray300Brush" Color="{StaticResource NeutralGray300}" />
    <SolidColorBrush x:Key="NeutralGray400Brush" Color="{StaticResource NeutralGray400}" />
    <SolidColorBrush x:Key="NeutralGray500Brush" Color="{StaticResource NeutralGray500}" />
    <SolidColorBrush x:Key="NeutralGray600Brush" Color="{StaticResource NeutralGray600}" />
    <SolidColorBrush x:Key="NeutralGray700Brush" Color="{StaticResource NeutralGray700}" />
    <SolidColorBrush x:Key="NeutralGray800Brush" Color="{StaticResource NeutralGray800}" />
    <SolidColorBrush x:Key="NeutralGray900Brush" Color="{StaticResource NeutralGray900}" />

    <!-- Shadow Tokens -->
    <x:Double x:Key="ShadowElevation1">2</x:Double>
    <x:Double x:Key="ShadowElevation2">4</x:Double>
    <x:Double x:Key="ShadowElevation3">8</x:Double>
    <x:Double x:Key="ShadowElevation4">16</x:Double>

    <!-- Corner Radius Tokens -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXLarge">16</CornerRadius>

    <!-- Spacing Tokens -->
    <x:Double x:Key="SpacingXSmall">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">16</x:Double>
    <x:Double x:Key="SpacingLarge">24</x:Double>
    <x:Double x:Key="SpacingXLarge">32</x:Double>
    <x:Double x:Key="SpacingXXLarge">48</x:Double>

    <!-- Typography Scale -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeading">24</x:Double>
    <x:Double x:Key="FontSizeDisplay">32</x:Double>

</ResourceDictionary>
