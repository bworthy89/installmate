<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        AccessibleStyles.xaml - Accessibility-focused styles and high-contrast support
        Includes keyboard focus visuals, screen reader support, and WCAG 2.1 compliance
    -->

    <!-- Accessible Button Style -->
    <!-- Ensures minimum 44x44 touch target, enhanced focus indicator, and high-contrast support -->
    <Style x:Key="AccessibleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource MinButtonWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource MinButtonHeight}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding RelativeSource={RelativeSource Self}, Path=Name}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
    </Style>

    <!-- Accessible TextBox Style -->
    <!-- Enhanced focus indicator and minimum height for touch -->
    <Style x:Key="AccessibleTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource MinTouchTargetSize}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding RelativeSource={RelativeSource Self}, Path=Name}" />
    </Style>

    <!-- Accessible ComboBox Style -->
    <Style x:Key="AccessibleComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource MinTouchTargetSize}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding RelativeSource={RelativeSource Self}, Path=Name}" />
    </Style>

    <!-- Accessible List Item Style -->
    <!-- Provides sufficient padding and clear focus indicator -->
    <Style x:Key="AccessibleListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource MinTouchTargetSize}" />
        <Setter Property="Padding" Value="{StaticResource ListItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}" />
    </Style>

    <!-- Status Indicator Styles (don't rely on color alone) -->
    <!-- Success Status - Green background + checkmark icon -->
    <Style x:Key="SuccessStatusStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandSuccessBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="AutomationProperties.Name" Value="Success" />
    </Style>

    <!-- Warning Status - Yellow/orange background + warning icon -->
    <Style x:Key="WarningStatusStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WarningBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandWarningBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="AutomationProperties.Name" Value="Warning" />
    </Style>

    <!-- Error Status - Red background + error icon -->
    <Style x:Key="ErrorStatusStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandErrorBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="AutomationProperties.Name" Value="Error" />
    </Style>

    <!-- Info Status - Blue background + info icon -->
    <Style x:Key="InfoStatusStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource InfoBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="AutomationProperties.Name" Value="Information" />
    </Style>

    <!-- Step Status Icons (for non-color status indication) -->
    <FontIcon x:Key="CompletedStepIcon" Glyph="&#xE73E;" Foreground="{StaticResource BrandSuccessBrush}" FontSize="20" />
    <FontIcon x:Key="PendingStepIcon" Glyph="&#xE7C3;" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="20" />
    <FontIcon x:Key="InProgressStepIcon" Glyph="&#xE768;" Foreground="{StaticResource BrandPrimaryBrush}" FontSize="20" />
    <FontIcon x:Key="ErrorStepIcon" Glyph="&#xE783;" Foreground="{StaticResource BrandErrorBrush}" FontSize="20" />

    <!-- Screen Reader Only Style -->
    <!-- Hides content visually but keeps it available to screen readers -->
    <Style x:Key="ScreenReaderOnlyStyle" TargetType="TextBlock">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="-1" />
        <Setter Property="Clip" Value="M 0,0 L 0,0 L 0,0 L 0,0" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Content" />
    </Style>

    <!-- Skip to Main Content Link (for keyboard navigation) -->
    <Style x:Key="SkipToMainLinkStyle" TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource TextOnPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="AutomationProperties.Name" Value="Skip to main content" />
        <Setter Property="AutomationProperties.AutomationId" Value="SkipToMainLink" />
        <!-- Hidden by default, visible on focus -->
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsTabStop" Value="True" />
    </Style>

    <!-- Accessibility Helper: Large Text Scaler -->
    <!-- Apply this to containers that should respect text scaling preferences -->
    <Style x:Key="TextScalingContainerStyle" TargetType="FrameworkElement">
        <Setter Property="AutomationProperties.AutomationId" Value="ScalableTextContainer" />
        <!-- Text scaling is applied at the root level by SettingsService -->
    </Style>

    <!--
        USAGE EXAMPLES WITH AUTOMATION PROPERTIES:

        1. Button with accessible name and help text:
        <Button Style="{StaticResource AccessibleButtonStyle}"
                AutomationProperties.Name="Save Installation Guide"
                AutomationProperties.HelpText="Saves the current installation guide to the database"
                Content="Save" />

        2. TextBox with accessible label:
        <TextBox Style="{StaticResource AccessibleTextBoxStyle}"
                 x:Name="GuideNameTextBox"
                 AutomationProperties.Name="Guide Name"
                 AutomationProperties.LabeledBy="{Binding ElementName=GuideNameLabel}" />

        3. Status indicator (non-color dependent):
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE73E;" Foreground="{StaticResource BrandSuccessBrush}" />
            <TextBlock Text="Completed" Style="{StaticResource BodyTextStyle}"
                       AutomationProperties.Name="Step status: Completed" />
        </StackPanel>

        4. List item with custom automation name:
        <ListView ItemContainerStyle="{StaticResource AccessibleListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid AutomationProperties.Name="{Binding Title}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Installation Guide:" />
                            <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        5. Live region for dynamic updates:
        <TextBlock x:Name="StatusMessage"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{Binding StatusMessage}" />
    -->

</ResourceDictionary>
