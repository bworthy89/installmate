<Page
    x:Class="InstallVibe.Views.Admin.AdminDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InstallVibe.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.GoBackCommand}" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="Admin Dashboard" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="24" MaxWidth="1200">
                <TextBlock Text="{x:Bind ViewModel.WelcomeMessage, Mode=OneWay}" FontSize="18" />

                <!-- Action Cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Create New Guide Card -->
                    <Button Grid.Column="0" Command="{x:Bind ViewModel.CreateNewGuideCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid Padding="32" Height="200">
                            <StackPanel VerticalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="&#xE710;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Create New Guide" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Build a new installation guide from scratch" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Manage Guides Card -->
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.ManageGuidesCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid Padding="32" Height="200">
                            <StackPanel VerticalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="&#xE8FD;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Manage Existing Guides" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="View, edit, or delete installation guides" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Recent Guides -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent Guides" FontSize="20" FontWeight="SemiBold" />

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,32,0,0" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentGuides, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuideListItem">
                                <Button Click="EditGuideButton_Click" Tag="{x:Bind Id}" HorizontalAlignment="Stretch" Padding="20" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind TotalSteps}" />
                                                    <Run Text="steps" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
