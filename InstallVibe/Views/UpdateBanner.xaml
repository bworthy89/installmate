<UserControl
    x:Class="InstallVibe.Views.UpdateBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:InstallVibe.ViewModels">

    <!--
        UpdateBanner - UI component for displaying update notifications

        This banner shows:
        - Update availability
        - Offline mode notification
        - Update action buttons
        - Mandatory update blocking UI

        Usage: Place at top of MainWindow or SettingsPage
    -->

    <Grid
        x:Name="UpdateBannerRoot"
        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
        Padding="16,12"
        Visibility="{x:Bind ViewModel.ShowUpdateBanner, Mode=OneWay}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Icon -->
        <FontIcon
            Grid.Column="0"
            Glyph="{x:Bind GetIconGlyph(ViewModel.IsOfflineMode, ViewModel.IsMandatoryUpdate), Mode=OneWay}"
            Foreground="{ThemeResource SystemFillColorAttentionBrush}"
            FontSize="20"
            Margin="0,0,12,0"
            VerticalAlignment="Center" />

        <!-- Message -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock
                Text="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                Style="{StaticResource BodyTextStyle}"
                TextWrapping="Wrap" />

            <!-- Version info (only when update available) -->
            <TextBlock
                Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}"
                Style="{StaticResource CaptionTextStyle}">
                <Run Text="Current: " />
                <Run Text="{x:Bind ViewModel.CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text=" → Latest: " />
                <Run Text="{x:Bind ViewModel.LatestVersion, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <!-- Release notes (if available) -->
            <TextBlock
                Text="{x:Bind ViewModel.ReleaseNotes, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ReleaseNotes, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                Style="{StaticResource CaptionTextStyle}"
                Foreground="{ThemeResource TextSecondaryBrush}"
                TextWrapping="Wrap"
                MaxLines="2" />
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
            <!-- Install Update Button -->
            <Button
                Content="Install Update"
                Command="{x:Bind ViewModel.InstallUpdateCommand}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}"
                AutomationProperties.Name="Install update" />

            <!-- Check for Updates Button (when offline mode clears) -->
            <Button
                Content="Check for Updates"
                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                Visibility="{x:Bind ViewModel.IsOfflineMode, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                AutomationProperties.Name="Check for updates" />
        </StackPanel>

        <!-- Close/Dismiss Button (not shown for mandatory updates or offline mode) -->
        <Button
            Grid.Column="3"
            Command="{x:Bind ViewModel.DismissUpdateCommand}"
            Style="{StaticResource SubtleButtonStyle}"
            Width="32"
            Height="32"
            Padding="0"
            Margin="8,0,0,0"
            ToolTipService.ToolTip="Dismiss"
            AutomationProperties.Name="Dismiss notification">
            <FontIcon Glyph="&#xE711;" FontSize="12" />
        </Button>
    </Grid>
</UserControl>
