<ContentDialog
    x:Class="InstallVibe.Views.FeedbackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InstallVibe.Views"
    xmlns:viewmodels="using:InstallVibe.ViewModels"
    xmlns:models="using:InstallVibe.Models"
    Title="Submit Feedback"
    PrimaryButtonText="Submit"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonCommand="{x:Bind ViewModel.SubmitFeedbackCommand}"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsSubmitting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">

    <ContentDialog.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="600">
        <StackPanel Spacing="12">
            <!-- Feedback Type -->
            <StackPanel>
                <TextBlock Text="Feedback Type *" FontWeight="SemiBold"/>
                <ComboBox
                    x:Name="FeedbackTypeComboBox"
                    AutomationProperties.Name="Feedback Type"
                    ItemsSource="{x:Bind ViewModel.FeedbackTypes}"
                    SelectedItem="{x:Bind ViewModel.SelectedFeedbackType, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Category -->
            <StackPanel>
                <TextBlock Text="Category *" FontWeight="SemiBold"/>
                <ComboBox
                    x:Name="CategoryComboBox"
                    AutomationProperties.Name="Feedback Category"
                    ItemsSource="{x:Bind ViewModel.Categories}"
                    SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Rating (optional) -->
            <StackPanel>
                <TextBlock Text="Rating (optional)"/>
                <RatingControl
                    x:Name="RatingControl"
                    AutomationProperties.Name="Rating"
                    Value="{x:Bind ViewModel.Rating, Mode=TwoWay}"
                    PlaceholderValue="0"
                    MaxRating="5"/>
            </StackPanel>

            <!-- Subject -->
            <StackPanel>
                <TextBlock Text="Subject *" FontWeight="SemiBold"/>
                <TextBox
                    x:Name="SubjectTextBox"
                    AutomationProperties.Name="Subject"
                    Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Brief summary of your feedback"
                    MaxLength="200"/>
            </StackPanel>

            <!-- Description -->
            <StackPanel>
                <TextBlock Text="Description *" FontWeight="SemiBold"/>
                <TextBox
                    x:Name="DescriptionTextBox"
                    AutomationProperties.Name="Description"
                    Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Provide detailed feedback..."
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    Height="120"
                    MaxLength="2000"/>
            </StackPanel>

            <!-- Bug Report Fields (conditional) -->
            <StackPanel Visibility="{x:Bind ViewModel.ShowBugFields, Mode=OneWay}">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Bug Report Details"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            FontWeight="SemiBold"/>

                        <!-- Severity -->
                        <StackPanel>
                            <TextBlock Text="Severity *" FontWeight="SemiBold"/>
                            <ComboBox
                                x:Name="SeverityComboBox"
                                AutomationProperties.Name="Issue Severity"
                                ItemsSource="{x:Bind ViewModel.Severities}"
                                SelectedItem="{x:Bind ViewModel.SelectedSeverity, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Steps to Reproduce -->
                        <StackPanel>
                            <TextBlock Text="Steps to Reproduce" FontWeight="SemiBold"/>
                            <TextBox
                                x:Name="StepsTextBox"
                                AutomationProperties.Name="Steps to Reproduce"
                                Text="{x:Bind ViewModel.StepsToReproduce, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="1. Open guide&#x0a;2. Click on step 3&#x0a;3. Error appears"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="80"
                                MaxLength="1000"/>
                        </StackPanel>

                        <!-- Expected Behavior -->
                        <StackPanel>
                            <TextBlock Text="Expected Behavior" FontWeight="SemiBold"/>
                            <TextBox
                                x:Name="ExpectedTextBox"
                                AutomationProperties.Name="Expected Behavior"
                                Text="{x:Bind ViewModel.ExpectedBehavior, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="What should happen?"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="60"
                                MaxLength="500"/>
                        </StackPanel>

                        <!-- Actual Behavior -->
                        <StackPanel>
                            <TextBlock Text="Actual Behavior" FontWeight="SemiBold"/>
                            <TextBox
                                x:Name="ActualTextBox"
                                AutomationProperties.Name="Actual Behavior"
                                Text="{x:Bind ViewModel.ActualBehavior, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="What actually happens?"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="60"
                                MaxLength="500"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Submit Message -->
            <InfoBar
                x:Name="SubmitMessageBar"
                IsOpen="{x:Bind ViewModel.SubmitMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Success"
                Message="{x:Bind ViewModel.SubmitMessage, Mode=OneWay}"/>

            <!-- Loading Indicator -->
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsSubmitting, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSubmitting, Mode=OneWay}"/>

            <!-- Privacy Notice -->
            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,8,0,0">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Glyph="&#xE946;"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock
                            Text="Privacy Notice"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap">
                        Your feedback will be reviewed by our team to improve InstallVibe.
                        No personally identifiable information will be shared without your consent.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
