<Page
    x:Class="InstallVibe.Views.GuideDetailView"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:InstallVibe.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.GoBackCommand}"
                Style="{StaticResource SubtleButtonStyle}"
                Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>

            <TextBlock
                Grid.Column="1"
                Text="Guide Details"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="24" MaxWidth="800">
                <!-- Loading Indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    Margin="0,32,0,0"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!-- Guide Header -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="10,6"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.Category, Mode=OneWay}"
                                FontSize="14"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                        FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Guide Info Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                Text="Total Steps"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.TotalSteps, Mode=OneWay}"
                                FontSize="24"
                                FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                Text="Progress"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold">
                                    <Run Text="{x:Bind ViewModel.CompletedSteps, Mode=OneWay}" />
                                    <Run Text="/" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{x:Bind ViewModel.TotalSteps, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock
                                Text="Est. Duration"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Text="{x:Bind ViewModel.EstimatedDurationMinutes, Mode=OneWay}"
                                    FontSize="24"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="min"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Progress Bar -->
                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Overall Progress"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <ProgressBar
                        Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                        Minimum="0"
                        Maximum="100"
                        Height="8"
                        CornerRadius="4" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" />
                        <Run Text="% complete" />
                    </TextBlock>
                </StackPanel>

                <!-- Start/Continue Button -->
                <Button
                    Content="{x:Bind ViewModel.StartButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.StartContinueGuideCommand}"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="0,12"
                    FontSize="16" />

                <!-- Steps List -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Steps"
                        FontSize="18"
                        FontWeight="SemiBold" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Steps, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:StepListItem">
                                <Button
                                    Command="{Binding ElementName=RootPage, Path=ViewModel.NavigateToStepCommand}"
                                    CommandParameter="{x:Bind}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,12,0">
                                            <TextBlock
                                                Text="{x:Bind StepNumber}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Title}"
                                            FontSize="15"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind CompletionIcon}"
                                            FontSize="18"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Created By -->
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                    <Run Text="Created by" />
                    <Run Text="{x:Bind ViewModel.CreatedBy, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
