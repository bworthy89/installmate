<Page
    x:Class="InstallVibe.Views.GuideLibraryView"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:InstallVibe.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.GoBackCommand}"
                Style="{StaticResource SubtleButtonStyle}"
                Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>

            <TextBlock
                Grid.Column="1"
                Text="Installation Guides"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="16">
                <!-- Search and Filter Bar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        PlaceholderText="Search guides..."
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Search guides">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextBoxBorderBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.5" />
                        </TextBox.Resources>
                    </TextBox>

                    <ComboBox
                        Grid.Column="2"
                        Header="Category"
                        ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Filter by category" />
                </Grid>

                <!-- Loading Indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    Margin="0,32,0,0"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!-- Guide List -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Guides, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuideListItem">
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Margin="0,0,0,12">
                                <Grid Padding="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Title and Category -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <Border
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Category}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind Description}"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        Margin="0,8,0,0" />

                                    <!-- Stats -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ProgressText}"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE121;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind DurationText}"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Progress Bar -->
                                    <ProgressBar
                                        Grid.Row="3"
                                        Value="{x:Bind ProgressPercentage}"
                                        Minimum="0"
                                        Maximum="100"
                                        Margin="0,12,0,0"
                                        Height="4" />

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                                        <!-- Edit Button (Admin Only) -->
                                        <Button
                                            Click="EditGuideButton_Click"
                                            Tag="{x:Bind Id}"
                                            Visibility="{x:Bind RootPage.ViewModel.IsAdmin}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="16,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE70F;" FontSize="16" />
                                                <TextBlock Text="Edit" />
                                            </StackPanel>
                                        </Button>

                                        <!-- View/Start Button -->
                                        <Button
                                            Click="GuideCard_Click"
                                            Tag="{x:Bind Id}"
                                            Padding="16,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                                <TextBlock Text="View" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
