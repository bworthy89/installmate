<Page
    x:Class="InstallVibe.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InstallVibe.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.GoBackCommand}" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="Settings" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="32" MaxWidth="800">
                <!-- Status Message -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource EmptyStringToBoolConverter}}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="Informational"
                    IsClosable="True" />

                <!-- Appearance Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />

                    <Border Style="{StaticResource FlatCardStyle}">
                        <StackPanel Spacing="20">
                            <!-- Theme Selection -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="App Theme" FontWeight="SemiBold" />
                                <TextBlock Text="Choose how InstallVibe looks" Style="{StaticResource CaptionTextStyle}" />
                                <ComboBox
                                    SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="200">
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                    <ComboBoxItem Content="Use system setting" />
                                </ComboBox>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Font Size Selection -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Font Size" FontWeight="SemiBold" />
                                <TextBlock Text="Adjust text size for better readability" Style="{StaticResource CaptionTextStyle}" />
                                <ComboBox
                                    SelectedIndex="{x:Bind ViewModel.SelectedFontSizeIndex, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="200">
                                    <ComboBoxItem Content="Small" />
                                    <ComboBoxItem Content="Normal" />
                                    <ComboBoxItem Content="Large" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Privacy Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Privacy" Style="{StaticResource SectionHeaderStyle}" />

                    <Border Style="{StaticResource FlatCardStyle}">
                        <StackPanel Spacing="12">
                            <ToggleSwitch
                                IsOn="{x:Bind ViewModel.TelemetryEnabled, Mode=TwoWay}"
                                Header="Send diagnostic data"
                                OnContent="Enabled"
                                OffContent="Disabled">
                                <ToggleSwitch.Description>
                                    <TextBlock TextWrapping="Wrap">
                                        Help improve InstallVibe by sending anonymous usage data and crash reports
                                    </TextBlock>
                                </ToggleSwitch.Description>
                            </ToggleSwitch>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Data Management Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Data Management" Style="{StaticResource SectionHeaderStyle}" />

                    <Border Style="{StaticResource FlatCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Clear All Data" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}">
                                    This will delete all guides, user progress, and reset the application to its initial state. This action cannot be undone.
                                </TextBlock>
                            </StackPanel>

                            <Button Click="ClearDataButton_Click" Foreground="{StaticResource BrandErrorBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    <TextBlock Text="Clear All Data" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />

                    <Border Style="{StaticResource FlatCardStyle}">
                        <StackPanel Spacing="16">
                            <!-- App Name and Logo -->
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="InstallVibe" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Guided Installations. Zero Guesswork." FontStyle="Italic" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Version Info -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Version" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                            </Grid>

                            <!-- Copyright -->
                            <TextBlock
                                Text="© 2025 InstallVibe. All rights reserved."
                                Style="{StaticResource CaptionTextStyle}"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
