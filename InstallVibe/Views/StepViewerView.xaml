<Page
    x:Class="InstallVibe.Views.StepViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:InstallVibe.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.GoBackCommand}"
                Style="{StaticResource SubtleButtonStyle}"
                Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock Text="Back to Guide" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar
                    Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                    Minimum="0"
                    Maximum="100"
                    Height="4"
                    Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="24" MaxWidth="900">
                <!-- Loading Indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    Margin="0,32,0,0"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!-- Step Header -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                        <Run Text="Step" />
                        <Run Text="{x:Bind ViewModel.StepNumber, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock
                        Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Safety Notes (if present) -->
                <Border
                    Background="#FFFEF5E7"
                    BorderBrush="#FFD95C00"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="16"
                    Visibility="{x:Bind ViewModel.SafetyNotes, Converter={StaticResource EmptyStringToVisibilityConverter}, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="18"
                                Foreground="#FFD95C00" />
                            <TextBlock
                                Text="Safety Notes"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#FFD95C00" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.SafetyNotes, Mode=OneWay}"
                            TextWrapping="Wrap"
                            FontSize="14"
                            Foreground="#FF8B4000" />
                    </StackPanel>
                </Border>

                <!-- Instructions -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Instructions"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="20">
                        <TextBlock
                            Text="{x:Bind ViewModel.Instruction, Mode=OneWay}"
                            TextWrapping="Wrap"
                            FontSize="15"
                            LineHeight="24" />
                    </Border>
                </StackPanel>

                <!-- Required Tools (if present) -->
                <StackPanel
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.RequiredTools, Converter={StaticResource EmptyStringToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock
                        Text="Required Tools"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE90F;"
                                FontSize="18"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.RequiredTools, Mode=OneWay}"
                                TextWrapping="Wrap"
                                FontSize="14"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Media Gallery -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Media"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Visibility="{x:Bind ViewModel.MediaItems.Count, Converter={StaticResource CountToVisibilityConverter}, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.MediaItems, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="200"
                                MinItemHeight="150"
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaItemDisplay">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="16"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind TypeIcon}"
                                            FontSize="48"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="{x:Bind FilePath}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Complete Step Button -->
                <Button
                    Content="{x:Bind ViewModel.CompleteButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleStepCompleteCommand}"
                    HorizontalAlignment="Stretch"
                    Padding="0,12"
                    FontSize="16">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Navigation -->
        <Grid
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="24,16"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.PreviousStepCommand}"
                IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                HorizontalAlignment="Left"
                Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE76B;" FontSize="16" />
                    <TextBlock Text="Previous Step" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.NextStepCommand}"
                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                HorizontalAlignment="Right"
                Style="{StaticResource AccentButtonStyle}"
                Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Next Step" />
                    <FontIcon Glyph="&#xE76C;" FontSize="16" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
